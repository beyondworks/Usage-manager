{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Manager",
  "version": "2.6.2",
  "identifier": "com.beyondworks.usagemanager",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Usage Manager",
        "width": 360,
        "height": 560,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "theme": "Dark"
      }
    ]
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
